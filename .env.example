# Runtime database (Supabase Postgres, service role). Every query is still project-scoped.
SEO_DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Where credentials referenced by projects.credentials_ref are resolved from: 'keyvault' | 'env'
SEO_SECRET_BACKEND=keyvault
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# LLM provider for analysts, gate stage 2 (analysts never get network tools)
ANTHROPIC_API_KEY=
SEO_ANALYST_MODEL=claude-sonnet-5
SEO_VERIFIER_MODEL=claude-sonnet-5
# Global external API keys (quotas are per key, so the rate limiter is global)
PAGESPEED_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Test database for the db-marked tests (never Supabase)
SEO_TEST_DATABASE_URL=postgresql://postgres@localhost:5433/seo_test
