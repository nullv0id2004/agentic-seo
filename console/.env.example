# Copy to console/.env.local (git-ignored); `npm run dev` loads it. Values below suit the local database
# from scripts/local_db.py; on App Service the same three are application settings.
# Console connects as the seo_console role (SELECT on derived tables, UPDATE on approvals.status only).
# Production: postgresql://seo_console_login:<password>@<supabase session pooler>:5432/postgres. Approvals decided
# against production are real.
CONSOLE_DATABASE_URL=postgresql://seo_console_login:local@localhost:5433/seo_dev
# Shared secret required on every request (middleware). Open http://localhost:3000/?token=<it> once; a cookie keeps
# you signed in. Replace with Supabase Auth when there is more than one approver.
CONSOLE_ACCESS_TOKEN=change-me
# The approver identity this deployment acts as. Must equal projects.approver_id for the projects it may decide.
CONSOLE_APPROVER_ID=93a8539c-c38d-427a-86af-150fbdb5539a
