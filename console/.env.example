# Console connects as the seo_console role (SELECT on derived tables, UPDATE on approvals.status only).
CONSOLE_DATABASE_URL=postgresql://seo_console_login:password@db.xxxx.supabase.co:5432/postgres
# Shared secret required on every request (middleware). Replace with Supabase Auth when there is more than one approver.
CONSOLE_ACCESS_TOKEN=change-me
# The approver identity this deployment acts as. Must equal projects.approver_id for the projects it may decide.
CONSOLE_APPROVER_ID=00000000-0000-4000-8000-000000000001
